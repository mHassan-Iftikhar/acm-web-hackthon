# Server
NODE_ENV=development
PORT=5000

# MongoDB (use MONGO_URI or MONGODB_URI)
# SRV format (can fail with querySrv ECONNREFUSED on some networks; use Standard then):
# MONGODB_URI=mongodb+srv://username:password@taakra-db.xxxxx.mongodb.net/taakra
# Standard format (if SRV fails): get from Atlas Connect → Drivers → standard connection string
# MONGO_URI=mongodb://user:pass@host1:27017,host2:27017,host3:27017/taakra?ssl=true&replicaSet=atlas-xxxx
# Local:
# MONGO_URI=mongodb://localhost:27017/taakra
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/taakra

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# AI Assistant (Gemini)
GEMINI_API_KEY=AIzaSyBjCCa6kc0w-WeQP4iZYq2CGg5Mu60SuUE
